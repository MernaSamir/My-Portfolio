---
import { ABOUT, PERSON } from '../../data/profile';
const lang = Astro.currentLocale === 'ar' ? 'ar' : 'en';
const L = (o: Record<string, string>) => o[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="sec" id="about" aria-labelledby="aboutT">
  <div class="wrap">
    <div class="sec-title reveal"><span class="kicker">{L(ABOUT.k)}</span><h2 id="aboutT">{L(ABOUT.t)}</h2></div>
    <div class="about">
      <article class="card intro spot reveal">
        <div class="pic"><img src={`${base}assets/merna.jpg`} alt={L(PERSON.name)} loading="lazy"><span class="badge">{L(ABOUT.badge)}</span></div>
        <h3>{L(ABOUT.h)}</h3>
        <p>{L(ABOUT.p1)}</p>
        <p>{L(ABOUT.p2)}</p>
      </article>
      <div class="info">
        <div class="card item reveal"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span><div><small>{L(ABOUT.name)}</small><b>Mirna Samir Mosaad</b><span class="sub ar-text">ميرنا سمير مسعد</span></div></div>
        <div class="card item reveal"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span><div><small>{L(ABOUT.loc)}</small><b>{L(PERSON.location)}</b><span class="sub">{L(ABOUT.locs)}</span></div></div>
        <a class="card item reveal" href={`mailto:${PERSON.email}`}><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 7l9 6 9-6"/></svg></span><div><small>{L(ABOUT.email)}</small><b class="ltr">{PERSON.email}</b></div></a>
        <a class="card item reveal" href={`tel:${PERSON.tel}`}><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 18h2"/></svg></span><div><small>{L(ABOUT.phone)}</small><b class="ltr">{PERSON.phone}</b></div></a>
        <a class="card item reveal" href={PERSON.linkedin} target="_blank" rel="noopener"><span class="ico"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21H9z"/></svg></span><div><small>{L(ABOUT.li)}</small><b class="ltr">in/mirna-samir-mosaad ↗</b></div></a>
        <div class="card item reveal"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c3 2 9 2 12 0v-5"/></svg></span><div><small>{L(ABOUT.edu)}</small><b>{L(ABOUT.eduv)}</b><span class="sub">{L(ABOUT.edus)}</span></div></div>
        <div class="card item reveal"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg></span><div><small>{L(ABOUT.lang)}</small><b>{L(ABOUT.langv)}</b><span class="sub">{L(ABOUT.langs)}</span></div></div>
        <div class="principles">
          {ABOUT.principles.map((p, i) => <div class="card principle spot reveal"><span class="n">0{i + 1}</span><h4>{L(p.t)}</h4><p>{L(p.p)}</p></div>)}
        </div>
      </div>
    </div>
  </div>
</section>
