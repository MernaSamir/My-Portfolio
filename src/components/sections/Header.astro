---
import { useT } from '../../i18n';
import { NAV, PERSON } from '../../data/profile';
const t = useT(Astro.currentLocale);
const lang = Astro.currentLocale === 'ar' ? 'ar' : 'en';
const L = (o: Record<string, string>) => o[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const home = lang === 'ar' ? base + 'ar/' : base;
const altHref = lang === 'ar' ? base : base + 'ar/';
const altLang = lang === 'ar' ? 'en' : 'ar';
---
<header class="top" id="hdr">
  <div class="wrap">
    <a href={`${home}#home`} class="brand" aria-label={L(PERSON.name)}><img src={`${base}assets/merna-face.jpg`} alt="" width="38" height="38"><span>Mirna<b>.</b></span></a>
    <nav class="menu" aria-label={t('nav.aria')}>
      <a href={`${home}#about`}>{L(NAV.about)}</a><a href={`${home}#intro`}>{L(NAV.video)}</a><a href={`${home}#skills`}>{L(NAV.skills)}</a><a href={`${home}#projects`}>{L(NAV.projects)}</a><a href={`${home}#career`}>{L(NAV.career)}</a><a href={`${home}#contact`} class="nav-hire">{L(NAV.contact)}</a>
    </nav>
    <div class="hdr-r">
      <button class="ibtn hide-sm" id="cmdBtn" aria-label={t('cmd.aria')} title="Ctrl + K">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg><kbd>Ctrl K</kbd>
      </button>
      <button class="ibtn hide-sm" id="soundBtn" aria-pressed="false" aria-label={t('d.sound')} title="Alt + S">
        <svg class="snd-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 9h4l5-4v14l-5-4H4z"></path><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"></path></svg>
        <svg class="snd-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 9h4l5-4v14l-5-4H4z"></path><path d="M17 9l5 6M22 9l-5 6"></path></svg>
      </button>
      <a class="ibtn" id="langBtn" href={altHref} hreflang={altLang} lang={altLang} aria-label={altLang === 'ar' ? 'التبديل إلى العربية' : 'Switch to English'}><span id="langLbl">{altLang === 'ar' ? 'ع' : 'EN'}</span></a>
      <button class="ibtn" id="themeBtn" aria-label={t('theme.aria')} title="Alt + T">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <button class="ibtn" data-open-settings aria-label={t('a11y.aria')} title="Ctrl + ,">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="4.5" r="1.8"></circle><path d="M5 8.5l7 1.5 7-1.5M12 10v5m0 0l-3.5 6.5M12 15l3.5 6.5"></path></svg>
        <span class="count" data-count></span>
      </button>
    </div>
  </div>
</header>
